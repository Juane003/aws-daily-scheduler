   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Observabilidad\n• CloudWatch: AgeOfOldestMessage FIFO\n• Alarma: cualquier DLQ > 0\n• Breaker OPEN > 30 min · errores 401/403\n• Ventana PROCESSING > 10 min\n• DailyCompletionPct · JobsDeferred\n• X-Ray + logs JSON (jobId, provider)",
   "originalText": "Observabilidad\n• CloudWatch: AgeOfOldestMessage FIFO\n• Alarma: cualquier DLQ > 0\n• Breaker OPEN > 30 min · errores 401/403\n• Ventana PROCESSING > 10 min\n• DailyCompletionPct · JobsDeferred\n• X-Ray + logs JSON (jobId, provider)",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "e6ehogfqrcl",
   "autoResize": true,
   "lineHeight": 1.25
  },
